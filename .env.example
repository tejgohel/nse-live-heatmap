# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your own values.
#  `.env` is git-ignored — never commit real credentials.
#
#  The heatmap reads LIVE market data, so a Dhan account with API access
#  (including the Data API add-on) is required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
#  https://dhanhq.co → My Profile → DhanHQ Trading APIs → Generate Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── Optional: TOTP auto-login ────────────────────────────────────────────────
#  With these set, a fresh access token is minted on every run.
#    DHAN_PIN         — the PIN you use to log into Dhan
#    DHAN_TOTP_SECRET — the base32 seed behind the 2FA QR code
DHAN_PIN=
DHAN_TOTP_SECRET=

# ── Dashboard ────────────────────────────────────────────────────────────────
HEATMAP_PORT=7000
PUSH_INTERVAL_SEC=30

# ── Previous close: "quote" (broker's official close) or "db" ────────────────
#  "quote" needs nothing else and is the default. "db" additionally needs a
#  local 5-minute candle database — see FIVEMIN_DB below.
PREVCLOSE_SOURCE=quote
# FIVEMIN_DB=/path/to/candles_5min.db
# FIVEMIN_TABLE=candles_5min_{sid}
# FIVEMIN_UPDATER=/path/to/your_updater.py

# ── Optional: public tunnel (ngrok). The URL is PUBLIC — do not share it. ─────
NGROK_ENABLED=0
# NGROK_PATH=ngrok
# NGROK_DOMAIN=
